# =====================================================================
# LLM Provider — choose ONE as your DEFAULT_PROVIDER, but we can have
# keys for multiple configured. The agent's LLM factory picks based on
# DEFAULT_PROVIDER at startup.
# =====================================================================

# Source: https://aistudio.google.com/app/apikey
# Free tier: 15 rpm / 1500/day for Gemini 2.0 Flash
GOOGLE_API_KEY=

# Source: https://console.groq.com/keys
# Free tier: 30 rpm / 6000 tokens/min for Llama 3.3 70B
GROQ_API_KEY=

# Source: https://console.anthropic.com/settings/keys
# SET A $20 MONTHLY SPEND CAP before adding a key
ANTHROPIC_API_KEY=

# =====================================================================
# LLM configuration
# =====================================================================

# Which provider to use by default. Options: gemini | groq | anthropic
DEFAULT_PROVIDER=gemini

# Model per provider (used by the agent when talking to LLM)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-5

# Eval judge
JUDGE_PROVIDER=groq
JUDGE_MODEL=llama-3.3-70b-versatile

# =====================================================================
# Observability
# =====================================================================

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# =====================================================================
# App config
# =====================================================================

LOG_LEVEL=INFO

INFRA_PROVIDER=mock

# Prompt version
PROMPT_VERSION=v1

# Audit log path
AUDIT_LOG_PATH=audit.log
