# LLM provider
DEFAULT_PROVIDER=gemini  # gemini | groq | anthropic

# Google Gemini (recommended default — free tier, 1500/day)
# Get from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (recommended for eval judge — free, fastest)
# Get from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (optional — paid)
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Eval judge
JUDGE_PROVIDER=groq
JUDGE_MODEL=llama-3.3-70b-versatile

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App config
LOG_LEVEL=INFO
INFRA_PROVIDER=mock  # mock | docker
PROMPT_VERSION=v1
AUDIT_LOG_PATH=audit.log